/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    ReproMB Atlas 16S pipeline — Nextflow config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default parameters. Values are the ones used for the ReproMB Atlas release
    2026.11 unless a comment says otherwise. See docs/methods_traceability.md
    for where each value is applied.
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {

    // ── Input/Output ────────────────────────────────────────────────────────
    input_csv             = null      // Study table, one row per study x body site (see README)
    data_dir              = null      // FASTQ root: <data_dir>/<accession>/... (nf-core/fetchngs layout)
    study_metadata_dir    = null      // Per-study sample metadata, <accession>.xlsx|.csv|.tsv
    outdir                = './results'
    tracedir              = "${params.outdir}/pipeline_info"

    // ── Reference ───────────────────────────────────────────────────────────
    // SILVA 138.2 SSURef NR99 as QIIME 2 artifacts (see docs/reference_database.md)
    silva_seqs            = null
    silva_tax             = null

    // ── Container ───────────────────────────────────────────────────────────
    // Every QIIME 2 step runs in this image. Release 2026.11 used the 2025.7 tag;
    // its digest is listed in README.md.
    qiime_container       = 'quay.io/qiime2/amplicon:2025.7'
    // Extra `docker run` options, e.g. bind mounts for FASTQ files that are
    // symlinks into another filesystem: '-v /data/raw:/data/raw'
    docker_extra_mounts   = ''

    // ── QIIME 2 import ──────────────────────────────────────────────────────
    phred_offset          = 33        // Phred+33 only; Phred+64 data must be converted first

    // ── Primer removal ──────────────────────────────────────────────────────
    run_primer_trim            = false  // true: remove primers by sequence with cutadapt before
                                        // quality profiling. false: DADA2 positional trim-left
                                        // equal to the primer length.
    cutadapt_error_rate        = 0.1    // Allowed mismatch fraction when matching primers
    cutadapt_discard_untrimmed = false  // false = reads lacking the primer pass through
                                        // untrimmed (safe for pre-trimmed submissions)
    cutadapt_min_length        = 1      // Drop reads reduced to < N bp after trimming

    // ── Denoiser ────────────────────────────────────────────────────────────
    denoiser              = 'dada2'   // 'dada2' (quality-driven; default) | 'deblur' (studies
                                      // with synthetic, flat quality scores)

    // ── Denoise operation mode ──────────────────────────────────────────────
    denoise_mode          = 'auto'    // 'auto': truncation derived per study from its quality
                                      // profile | 'manual': per-study values from --manual_params
    manual_params         = null      // CSV with one row per processing unit (examples/)

    // ── DADA2 ───────────────────────────────────────────────────────────────
    denoise_auto          = true      // Use the per-study quality-derived truncation
    trunc_len_f           = null      // Global trunc-len-f (disables the automatic choice)
    trunc_len_r           = null      // Global trunc-len-r (disables the automatic choice)
    trim_left_f           = null      // Global trim-left-f
    trim_left_r           = null      // Global trim-left-r
    max_ee                = 2.0       // Max expected errors per read
    trunc_q               = 2         // Truncation quality score threshold
    min_overlap           = 12        // Min overlap for paired-end merging (may be lowered per
                                      // study, see bin/parse_quality_stats.py)
    max_merge_mismatch    = 0         // Max mismatches in overlap region
    pooling_method        = 'independent'  // independent | pseudo
    chimera_method        = 'consensus'    // consensus | pooled | none
    n_reads_learn         = 1000000   // Reads used for error model learning

    // ── Deblur ──────────────────────────────────────────────────────────────
    // Deblur does not use quality scores: its error model is a static positional
    // profile applied above a fixed trim length.
    //
    // The trim length must be a single value per region group so that identical
    // sequences collapse to the same feature. Resolution order:
    //   manual_params[deblur_trim_length] → deblur_trim_length_by_region[region]
    //   → deblur_trim_length. A non-positive result stops the run.
    deblur_trim_length            = 0     // Global fallback (bp). 0 = unset
    deblur_trim_length_by_region  = [:]   // e.g. [ 'V4': 150, 'V3-V4': 250 ]

    // Overlapping regions are merged with vsearch before Deblur; long regions that
    // do not overlap at typical read lengths are processed forward-only.
    deblur_forward_regions        = ['V3-V5', 'V1-V5', 'V1-V6', 'V1-V9']

    // vsearch merge-pairs. Deblur merges raw reads (DADA2 merges after error
    // correction), so DADA2's zero-mismatch rule rejects genuine overlaps.
    // maxdiffs = 10 was chosen from a sweep on the release studies.
    deblur_merge_minovlen         = null  // null = params.min_overlap (12)
    deblur_merge_maxdiffs         = 10

    deblur_min_quality            = 4     // q-score filter; QIIME 2 default (no effect at flat Q30)
    deblur_min_reads              = 50    // Drop sOTUs seen in < N reads across all samples
                                          // (QIIME 2 default is 10)
    deblur_min_size               = 2     // Min per-sample size before dereplication

    // ── Automatic truncation (DADA2) ────────────────────────────────────────
    quality_drop_threshold = 20       // 25th-percentile quality threshold for truncation
    quality_p9_threshold   = 15       // 9th-percentile threshold for the read-tail check
    quality_sample_n       = 10000    // Reads sampled by `qiime demux summarize`
    quality_percentile     = '25%'    // Primary percentile for the truncation rule
    quality_window         = 10       // Sliding window (bp) used to smooth the primary percentile
    tail_check_window      = 20       // Last N positions scanned for 9th-percentile collapse

    // ── Denoising QC (reporting only; does not remove samples) ──────────────
    min_reads_passing_pct     = 50.0  // Min % input reads passing the filter
    min_reads_merged_pct      = 60.0  // Min % input reads merged (paired-end)
    min_reads_nonchimeric_pct = 60.0  // Min % input reads non-chimeric
    min_reads_output          = 100   // Min reads per sample after denoising
    heterogeneity_cv_max      = 2.0   // CV of output read counts above which a warning is raised

    // ── Adaptive retry (DADA2) ──────────────────────────────────────────────
    retry_denoise       = true   // One re-parametrised second pass for failed studies
    retry_filter_pct    = 40     // Failed if median % passing filter < this
    retry_merged_pct    = 30     // Failed if median % merged < this (paired-end)
    retry_zero_frac     = 0.30   // Failed if > this fraction of samples have no output
    retry_quality_floor = 20     // 25th-percentile floor used to extend truncation when
                                 // the predicted overlap is marginal

    // ── Taxonomy ────────────────────────────────────────────────────────────
    classifier_alpha      = 0.001     // Naive Bayes smoothing (fit-classifier-naive-bayes)
    classifier_cache_dir  = null      // Reuse classifiers built in a previous run
    classify_confidence   = 0.7       // classify-sklearn confidence
    collapse_level        = 6         // 6 = genus

    // ── Per-study summaries (not used to build the Atlas tables) ────────────
    run_diversity         = true      // Shannon, observed features, Simpson, Bray-Curtis,
                                      // Jaccard and PERMANOVA within each study

    // ── Resources ───────────────────────────────────────────────────────────
    help                  = false
    max_retries           = 1
    max_cpus              = 16
    max_memory            = '128.GB'
    max_time              = '240.h'
}

includeConfig 'conf/base.config'

docker {
    enabled       = true
    runOptions    = "-u \$(id -u):\$(id -g) ${params.docker_extra_mounts}"
}

singularity {
    enabled       = false
    autoMounts    = true
}

profiles {
    debug {
        dumpHashes           = true
        process.beforeScript = 'echo $HOSTNAME'
    }
    docker {
        docker.enabled       = true
        singularity.enabled  = false
    }
    singularity {
        singularity.enabled  = true
        docker.enabled       = false
    }
    slurm {
        process.executor     = 'slurm'
        process.queue        = 'batch'
    }
    test {
        params.max_cpus   = 4
        params.max_memory = '16.GB'
        params.max_time   = '6.h'
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

// Timeline, report, trace, DAG
def trace_timestamp = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')
timeline {
    enabled = true
    file    = "${params.tracedir}/execution_timeline_${trace_timestamp}.html"
}
report {
    enabled = true
    file    = "${params.tracedir}/execution_report_${trace_timestamp}.html"
}
trace {
    enabled = true
    file    = "${params.tracedir}/execution_trace_${trace_timestamp}.txt"
}
dag {
    enabled = true
    file    = "${params.tracedir}/pipeline_dag_${trace_timestamp}.svg"
}

manifest {
    name            = 'reprombatlas-16s-pipeline'
    author          = 'Ignacio Garach Vélez'
    homePage        = ''
    description     = 'Uniform reprocessing of public 16S rRNA amplicon studies for the ReproMB Atlas'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
